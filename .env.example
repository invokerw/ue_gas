# 复制为仓库根目录的 .env，并替换为本机的绝对路径。
# .env 会被 Git 忽略，不要把真实机器路径提交到仓库。

# Launcher/下载版 UE，用于普通 Editor、Automation 和资产校验。
UE_INSTALLED_EDITOR="C:/Path/To/InstalledUE/Engine/Binaries/Win64/UnrealEditor.exe"

# 从源码编译的 UE Editor，用于 Server/Client Target 和 Dedicated smoke。
UE_SOURCE_EDITOR="D:/Path/To/SourceUE/Engine/Binaries/Win64/UnrealEditor.exe"
